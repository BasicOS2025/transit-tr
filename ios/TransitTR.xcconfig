PRODUCT_NAME = TransitTR
TRANSIT_BUNDLE_ID = org.transittr.ios
TRANSIT_APP_GROUP = group.org.transittr.ios
LEGACY_IOS_TARGET = 11.0
IPHONEOS_DEPLOYMENT_TARGET = $(LEGACY_IOS_TARGET)
PRODUCT_BUNDLE_IDENTIFIER = $(TRANSIT_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = TransitTR.entitlements
MARKETING_VERSION = 1.1
CURRENT_PROJECT_VERSION = 2
INFOPLIST_FILE = TransitTR/Info.plist
GENERATE_INFOPLIST_FILE = NO
CODE_SIGN_STYLE = Automatic
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
OTHER_LDFLAGS = $(inherited) -lsqlite3 -weak_framework WidgetKit
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
TRANSIT_API_URL = https:/$()/transit-tr.vercel.app
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
